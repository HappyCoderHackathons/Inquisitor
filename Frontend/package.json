{
  "name": "inputprint-arcade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild frontend/app.ts frontend/dashboard.ts frontend/onboarding.ts --bundle --outdir=static --target=es2020",
    "dev": "esbuild frontend/app.ts frontend/dashboard.ts frontend/onboarding.ts --bundle --outdir=static --target=es2020 --watch",
    "typecheck": "tsc",
    "format": "prettier --write frontend",
    "format:check": "prettier --check frontend"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "3.10.1",
    "typescript": "^5.7.0"
  }
}
