{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InputPrint feature window v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "session_id",
    "sequence",
    "mode",
    "started_at",
    "duration_ms",
    "features",
    "mouse_features"
  ],
  "properties": {
    "schema_version": {
      "const": 2,
      "type": "integer"
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "enum": [
        "enrollment",
        "monitoring"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_count",
        "presses_per_second",
        "hold_mean_ms",
        "hold_std_ms",
        "press_interval_mean_ms",
        "press_interval_std_ms",
        "press_interval_p90_ms",
        "pause_count",
        "pause_fraction",
        "burst_count",
        "press_overlap_fraction"
      ],
      "properties": {
        "key_count": {
          "type": "integer",
          "minimum": 0
        },
        "presses_per_second": {
          "type": "number",
          "minimum": 0
        },
        "hold_mean_ms": {
          "type": "number",
          "minimum": 0
        },
        "hold_std_ms": {
          "type": "number",
          "minimum": 0
        },
        "press_interval_mean_ms": {
          "type": "number",
          "minimum": 0
        },
        "press_interval_std_ms": {
          "type": "number",
          "minimum": 0
        },
        "press_interval_p90_ms": {
          "type": "number",
          "minimum": 0
        },
        "pause_count": {
          "type": "integer",
          "minimum": 0
        },
        "pause_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "burst_count": {
          "type": "integer",
          "minimum": 0
        },
        "press_overlap_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "mouse_features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_count",
        "speed_mean_px_s",
        "speed_std_px_s",
        "acceleration_mean_px_s2",
        "acceleration_std_px_s2",
        "turn_angle_mean_rad",
        "click_count",
        "click_interval_mean_ms",
        "click_interval_std_ms"
      ],
      "properties": {
        "move_count": {
          "type": "integer",
          "minimum": 0
        },
        "speed_mean_px_s": {
          "type": "number",
          "minimum": 0
        },
        "speed_std_px_s": {
          "type": "number",
          "minimum": 0
        },
        "acceleration_mean_px_s2": {
          "type": "number",
          "minimum": 0
        },
        "acceleration_std_px_s2": {
          "type": "number",
          "minimum": 0
        },
        "turn_angle_mean_rad": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.141592653589793
        },
        "click_count": {
          "type": "integer",
          "minimum": 0
        },
        "click_interval_mean_ms": {
          "type": "number",
          "minimum": 0
        },
        "click_interval_std_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
